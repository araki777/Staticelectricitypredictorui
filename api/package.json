{
  "name": "static-electricity-predictor-api",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts",
    "build": "esbuild src/functions/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=index.js --external:@azure/functions --external:@prisma/adapter-mssql --external:mssql && prisma generate --schema=prisma/schema.prisma",
    "watch": "tsc -w",
    "generate": "prisma generate --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@azure/functions": "^4.12.0",
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.19.11",
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "1.2.3",
    "@marplex/hono-azurefunc-adapter": "^1.0.1",
    "@prisma/adapter-mssql": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "dotenv": "^16.4.0",
    "hono": "^4.12.9",
    "mssql": "^12.2.1",
    "tedious": "^19.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "prisma": "^7.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.4"
  }
}